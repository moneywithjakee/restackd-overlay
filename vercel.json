{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",                      "value": "ALLOWALL" },
        { "key": "Content-Security-Policy",              "value": "frame-ancestors *;" },
        { "key": "Cache-Control",                        "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
